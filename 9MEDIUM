#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <dirent.h>
#include <pthread.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8080
#define BUFFER_SIZE 4096
#define FILE_DIR "./server_files/"

void *handle_client(void *client_socket);
void send_file_list(int sock);
void send_file(int sock, char *filename);

int main() {
    int server_fd, *new_sock;
    struct sockaddr_in address;
    int addrlen = sizeof(address);

    // Create server directory if it doesn't exist
    system("mkdir -p " FILE_DIR);

    // 1. Create TCP Socket
    if ((server_fd = socket(AF_INET, SOCK_STREAM, 0)) == 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // Allow socket reuse
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(PORT);

    // 2. Bind Socket
    if (bind(server_fd, (struct sockaddr *)&address, sizeof(address)) < 0) {
        perror("Bind failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // 3. Listen for Connections
    if (listen(server_fd, 10) < 0) {
        perror("Listen failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    printf("📁 Concurrent File Server started on port %d...\n", PORT);

    // 4. Main Acceptance Loop
    while (1) {
        int client_fd = accept(server_fd, (struct sockaddr *)&address, (socklen_t*)&addrlen);
        if (client_fd < 0) {
            perror("Accept failed");
            continue;
        }

        printf("✅ Client connected from %s:%d\n", inet_ntoa(address.sin_addr), ntohs(address.sin_port));

        pthread_t thread_id;
        new_sock = malloc(sizeof(int));
        *new_sock = client_fd;

        // Spawn a new detached thread for the client
        if (pthread_create(&thread_id, NULL, handle_client, (void*)new_sock) < 0) {
            perror("Could not create thread");
            free(new_sock);
            close(client_fd);
        }
        pthread_detach(thread_id); // Automatically reclaim resources on exit
    }

    close(server_fd);
    return 0;
}

void *handle_client(void *client_socket) {
    int sock = *(int*)client_socket;
    free(client_socket);
    char buffer[BUFFER_SIZE];

    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        int bytes_read = recv(sock, buffer, BUFFER_SIZE - 1, 0);
        
        if (bytes_read <= 0) {
            printf("⚠️ Client disconnected abruptly.\n");
            break;
        }

        // Clean command strings
        buffer[strcspn(buffer, "\r\n")] = 0;

        if (strcmp(buffer, "LIST") == 0) {
            send_file_list(sock);
        } 
        else if (strncmp(buffer, "GET ", 4) == 0) {
            char *filename = buffer + 4;
            send_file(sock, filename);
        } 
        else if (strcmp(buffer, "EXIT") == 0) {
            printf("🚪 Client requested exit. Closing connection cleanly.\n");
            break;
        } 
        else {
            char *msg = "ERROR: Unknown Command\n";
            send(sock, msg, strlen(msg), 0);
        }
    }

    close(sock);
    return NULL;
}

void send_file_list(int sock) {
    DIR *d = opendir(FILE_DIR);
    struct dirent *dir;
    char buffer[BUFFER_SIZE] = "";

    if (d) {
        while ((dir = readdir(d)) != NULL) {
            // Exclude hidden directories
            if (dir->d_name[0] != '.') {
                strcat(buffer, dir->d_name);
                strcat(buffer, "\n");
            }
        }
        closedir(d);
    }
    
    if (strlen(buffer) == 0) {
        strcpy(buffer, "(No files available)\n");
    }
    
    strcat(buffer, "__EOF__\n"); // End of listing marker
    send(sock, buffer, strlen(buffer), 0);
}

void send_file(int sock, char *filename) {
    char filepath[BUFFER_SIZE];
    snprintf(filepath, sizeof(filepath), "%s%s", FILE_DIR, filename);

    FILE *file = fopen(filepath, "rb");
    if (file == NULL) {
        char *msg = "ERROR: File not found\n";
        send(sock, msg, strlen(msg), 0);
        return;
    }

    // Confirm file exists to client
    send(sock, "START\n", 6, 0);
    usleep(10000); // Prevent packet coalescing

    char file_buffer[BUFFER_SIZE];
    int bytes_read;
    while ((bytes_read = fread(file_buffer, 1, BUFFER_SIZE, file)) > 0) {
        send(sock, file_buffer, bytes_read, 0);
    }

    fclose(file);
    usleep(50000); // Give socket time to flush data
    send(sock, "__EOF__\n", 8, 0); // Safe transfer completion tag
    printf("📤 Successfully transferred file: %s\n", filename);
}
